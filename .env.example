# Copy to .env next to docker-compose.yml. Never commit .env.
MYSQL_PASSWORD=wms_pass
MYSQL_ROOT_PASSWORD=change_me_root
APP_PORT=8080
# On the server: APP_PORT=127.0.0.1:8084 (reachable only through Caddy)
CORS_ORIGINS=http://localhost:8080
# On the server: CORS_ORIGINS=https://wms.nexdaequmsupport.com
# Signs login tokens. On the server: AUTH_SECRET=$(openssl rand -hex 32)
AUTH_SECRET=dev-only-secret-change-me
# Hours before users must log in again
AUTH_HOURS=12
# false switches off "Load demo" and "replace all data" import. Use false on the server.
ALLOW_RESET=true
